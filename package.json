{
  "name": "ecohotel-madeguadua",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build && npm run build:api",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.mjs",
    "start": "NODE_ENV=production node dist-server/index.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react-datepicker": "^6.2.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
