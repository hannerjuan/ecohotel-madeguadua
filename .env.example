# Copia este archivo como .env y ajusta los valores. Ninguno es obligatorio en desarrollo.

# Puerto de la API (en desarrollo Vite corre en 3000 y reenvía /api a este puerto).
PORT=8080

# De dónde salen los datos:
#   memory    = datos de ejemplo en memoria, sin credenciales (por defecto en desarrollo)
#   firestore = la base real de Firebase (por defecto en producción)
# DATA_BACKEND=firestore

# Credenciales de Firebase Admin para DATA_BACKEND=firestore. Usa UNA de estas opciones:
#   1. JSON completo de una cuenta de servicio (Consola de Firebase > Configuración > Cuentas de servicio)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
#   2. Ruta a ese archivo JSON
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/cuenta-de-servicio.json
#   3. En Cloud Run no hace falta nada: se usan las credenciales del servicio.

# Correos con acceso al panel de administración (separados por coma).
# También se puede dar acceso con el campo role: "admin" en users/{uid} de Firestore.
ADMIN_EMAILS=ecohotelmadeguadua@gmail.com

# Solo si la web y la API están en dominios distintos:
# CORS_ORIGINS=https://www.ecohotelmadeguadua.com
# VITE_API_URL=https://api.ecohotelmadeguadua.com

# Tamaño máximo por imagen subida, en MB.
# MAX_UPLOAD_MB=8
