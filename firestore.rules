rules_version = '2';

// Todos los datos pasan por el backend propio (server/), que usa el Admin SDK de Firebase.
// El Admin SDK no está sujeto a estas reglas, así que el navegador no necesita acceso directo:
// se bloquea todo para que nadie pueda leer datos de huéspedes ni escribir saltándose la API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
